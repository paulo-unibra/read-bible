{
  "expo": {
    "name": "Bíblia em Foco",
    "slug": "ReadBible",
    "version": "1.0.32",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "readbible",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readbible.app",
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-5942901200629242~1274274321"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Permitir o uso do microfone para gravar sua voz nos hinos da Harpa.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.readbible.app",
      "versionCode": 29,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-v2.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-5942901200629242~1274274321"
      },
      "permissions": [
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "READ_MEDIA_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96cae4dd-d05b-4021-b8ca-b80d0ab20403"
      },
      "apiUrl": "https://bibliafoco.com.br"
    },
    "owner": "paulo_nlw"
  }
}
