TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# DeepSeek API Configuration
# Obtenha sua chave em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Google Drive Configuration
# ID da pasta onde os quizzes serão salvos
GOOGLE_DRIVE_FOLDER_ID=12CZeaVlNKMfO3gT5PpOFdVgvY7fEQ0Yq

# Credenciais da Service Account (JSON completo em uma linha)
# Para configurar:
# 1. Acesse https://console.cloud.google.com/
# 2. Crie uma Service Account
# 3. Baixe o arquivo JSON de credenciais
# 4. Cole TODO o conteúdo JSON aqui (mantenha em uma única linha, sem quebras)
# 5. Compartilhe a pasta do Drive com o email da Service Account
#
# IMPORTANTE: Se não quiser usar Google Drive por enquanto, deixe vazio
# e comente a linha do GoogleDriveService no controller
GOOGLE_DRIVE_CREDENTIALS=

# Email Configuration for Password Reset
# Para Gmail, você precisa criar uma "Senha de app":
# 1. Acesse https://myaccount.google.com/security
# 2. Ative a verificação em duas etapas
# 3. Vá em "Senhas de app" e gere uma senha
# 4. Use essa senha de 16 caracteres (sem espaços) no SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui
SMTP_FROM=seu-email@gmail.com
SMTP_FROM_NAME=Bíblia em Foco

# Google Play Developer Reporting API Configuration
# Para configurar:
# 1. Acesse https://console.cloud.google.com/
# 2. Crie/use uma Service Account
# 3. Habilite a API "Google Play Developer Reporting API"
# 4. Baixe o arquivo JSON de credenciais
# 5. Cole TODO o conteúdo JSON aqui (mantenha em uma única linha)
# 6. No Google Play Console, vá em Configurações > Acesso à API
# 7. Conceda acesso à Service Account com permissões de visualização
#
# Formato (tudo em uma linha):
# GOOGLE_PLAY_CREDENTIALS='{"type":"service_account","project_id":"nutotia","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"play-store-reporting@nutotia.iam.gserviceaccount.com",...}'
GOOGLE_PLAY_CREDENTIALS=

# Nome do pacote do app na Google Play Store
GOOGLE_PLAY_PACKAGE_NAME=com.biblia.foco
