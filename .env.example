# Copie este arquivo para `.env` e preencha os valores.
# Todas as variáveis expostas no bundle precisam do prefixo EXPO_PUBLIC_
# Atenção: chaves Firebase (apiKey) não são consideradas secretas no cliente, mas evitamos commit por organização.

# Google / Drive
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_DRIVE_FOLDER_ID=
# Pasta específica para quizzes (opcional). Se não definir, usa EXPO_PUBLIC_DRIVE_FOLDER_ID
EXPO_PUBLIC_QUIZ_DRIVE_FOLDER_ID=
# Pasta específica para áudios (opcional). Se não definir, usa EXPO_PUBLIC_DRIVE_FOLDER_ID
EXPO_PUBLIC_AUDIO_DRIVE_FOLDER_ID=

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
