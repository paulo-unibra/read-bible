<IfModule mod_rewrite.c>
  RewriteEngine On

  # Base do app
  RewriteBase /admin/

  # Nao mexe em arquivos reais (css, js, imagens, fontes, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tudo o resto cai no index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://bibliafoco.com.br; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

  # O index.html nunca deve ficar em cache: ele referencia os arquivos
  # com hash (style-XXXX.css, index-XXXX.js). Se o navegador guardar um
  # index.html antigo depois de um novo deploy, ele vai tentar carregar
  # um CSS/JS que ja nao existe mais no servidor (parece "css quebrado").
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Ja os arquivos com hash no nome podem (e devem) ser cacheados forte,
  # pois o nome muda sempre que o conteudo muda.
  <FilesMatch "\.(js|css|svg|png|jpe?g|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
